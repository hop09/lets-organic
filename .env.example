# ── REQUIRED ──────────────────────────────────────────────
# The app will refuse to start if these are missing.

# MongoDB Connection String
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/letsorganic?retryWrites=true&w=majority"

# Admin Authentication — generate a long random string for the secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="paste-a-long-random-secret-here"
ADMIN_EMAIL="admin@letsorganic.store"
ADMIN_PASSWORD="choose-a-strong-password-here"

# ── OPTIONAL ──────────────────────────────────────────────
# Server-side order notification emails via Web3Forms.
# If unset, orders are still saved to the database (admin Orders tab),
# but no notification email is sent.
WEB3FORMS_KEY=""

# Hidden Admin Access
NEXT_PUBLIC_ADMIN_PATH="/console-gate-4527"

# Public Site Info
NEXT_PUBLIC_SITE_NAME="Lets Organic"
